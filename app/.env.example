# Mẫu biến môi trường. Chép thành `.env` rồi sửa giá trị cho từng máy / từng lần deploy.
# File này KHÔNG chứa bí mật thật — đừng dán mật khẩu production vào đây.

# Kết nối cơ sở dữ liệu SQLite (đường dẫn tương đối tính từ thư mục app/).
DATABASE_URI=file:./hiacc.db

# Chuỗi bí mật Payload dùng để ký cookie đăng nhập.
# ⚠️ BẮT BUỘC có giá trị — thiếu biến này thì ứng dụng dừng ngay lúc khởi động,
#    KHÔNG còn giá trị mặc định trong mã nguồn nữa.
# Sinh chuỗi mới cho từng môi trường (mỗi môi trường một chuỗi riêng):
#     openssl rand -hex 32
# Đổi chuỗi này sẽ làm mất mọi phiên đăng nhập admin đang mở — phải đăng nhập lại.
# ĐỪNG dán giá trị thật vào file này (file này được commit).
PAYLOAD_SECRET=

# Địa chỉ máy chủ Payload dùng cho trang admin và link trong email.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Tên miền công khai của website, dùng cho robots.txt, sitemap.xml, thẻ canonical,
# ảnh chia sẻ Facebook/Zalo và dữ liệu có cấu trúc (JSON-LD).
# Ghi đầy đủ giao thức, KHÔNG có dấu gạch chéo ở cuối. Ví dụ: https://hiacc.com.vn
# Bỏ trống thì hệ thống tự dùng http://localhost:3000 (chỉ hợp cho máy lập trình).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Đánh dấu đây là bản nháp cho khách duyệt, KHÔNG phải bản chạy thật.
# 'true'  → hiện dải "Bản dùng thử" + cấm Google đánh chỉ mục (robots + noindex).
# bỏ trống / 'false' → chạy như bản thật.
# ⚠️ Quên xoá biến này khi lên production = site thật không lên tìm kiếm được.
# ⚠️ Không đổi tên thành NEXT_PUBLIC_IS_STAGING — biến NEXT_PUBLIC_* bị Next
#    thay bằng giá trị cứng lúc build, đặt lúc chạy sẽ vô tác dụng (im lặng).
IS_STAGING=
